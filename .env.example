APP_NAME="Habitat PMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bnb
DB_USERNAME=bnb
DB_PASSWORD=bnb

# Separate database used by the automated test suite.
DB_TEST_DATABASE=bnb_testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

# Comma separated list of domains that may authenticate via cookie based SPA sessions.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@habitatpms.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Platform configuration
# ---------------------------------------------------------------------------

# Payments: "mock" ships with the product for development and testing.
PAYMENTS_DEFAULT_PROVIDER=mock

# AI provider: "null" performs no external calls, "echo" produces deterministic
# local output that is useful for development and tests, and "claude" is a real
# model. With "claude" selected but no key set, the provider reports itself as
# not live and says why, in the interface and in every draft it produces.
AI_DEFAULT_PROVIDER=echo
ANTHROPIC_API_KEY=
# Only for an organization-level key. A key created inside a workspace already
# carries its scope; an organization-level one does not, and the API refuses the
# request rather than guessing whose workspace to bill.
ANTHROPIC_WORKSPACE_ID=
# Haiku is the default: the agent's work is a classification and a short reply
# from a fixed set of facts, which does not need a larger model. Change it and
# re-run `php artisan agent:evaluate` — the two numbers it prints are the honest
# basis for the trade. `php artisan ai:check` makes one real call and reports
# what it cost.
ANTHROPIC_MODEL=claude-haiku-4-5

# Smart lock provider used when a property has no explicit provider configured.
LOCKS_DEFAULT_PROVIDER=mock

# Outbound webhook signing / delivery
WEBHOOKS_MAX_ATTEMPTS=8
WEBHOOKS_TIMEOUT=10

# Channel synchronisation
CHANNELS_SYNC_ENABLED=true
CHANNELS_MAX_ATTEMPTS=6

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000
